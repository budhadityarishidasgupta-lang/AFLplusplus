# Copy to .env only for local development; never commit .env.
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY
SOVEREIGN_ALIBABA_REGION=eu-central-1
SOVEREIGN_ALIBABA_WORKSPACE_ID=YOUR_WORKSPACE_ID
SOVEREIGN_ALIBABA_MODEL=YOUR_ACCOUNT_ENABLED_QWEN_MODEL
# Optional; default is the workspace-dedicated Frankfurt OpenAI-compatible endpoint.
SOVEREIGN_ALIBABA_BASE_URL=
SOVEREIGN_ALIBABA_TIMEOUT_SECONDS=60
SOVEREIGN_ALIBABA_MAX_OUTPUT_TOKENS=768
SOVEREIGN_ALIBABA_CONTEXT_TOKENS=12000

# Optional OpenAI provider
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
SOVEREIGN_OPENAI_MODEL=YOUR_ACCOUNT_ENABLED_OPENAI_MODEL
SOVEREIGN_OPENAI_MAX_OUTPUT_TOKENS=768
